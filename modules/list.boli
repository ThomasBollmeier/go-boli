#|
Various list functions
|#

(def (reverse lst)
  (def (helper l acc)
    (if l
      (helper (cdr l) (cons (car l) acc))
      acc))
  (helper lst nil))

(def (enumerate lst)
  (def (helper i l acc)
    (if l
      (helper (+ i 1) (cdr l) (cons (i . (car l)) acc))
      (reverse acc)))
  (helper 0 lst nil))

(def (member val lst eq-fn)
     (if (empty? lst)
     	  #f
	      (let ([x (car lst)])
	         (if (eq-fn val x)
	        	  lst
		          (member val (cdr lst) eq-fn)))))

(def (member val lst)
     (member val lst =))

(def (foldl fn init-val lst)
     (if (empty? lst)
     	 init-val
	 (foldl fn
		(fn init-val (car lst))
         	(cdr lst))))

(def (foldr fn init-val lst)
     (foldl (λ (acc it) (fn it acc))
	    init-val
            (reverse lst)))

(def (reduce fn lst)
     (foldl fn (car lst) (cdr lst)))

(def (list->vector lst)
     (def (helper lst acc)
     	  (if (empty? lst)
	      acc
	      (block
		(vector-append! acc (car lst))
		(helper (cdr lst) acc))))
     (helper lst (vector)))

(def (flatten-n depth lst)
     (def (helper l acc)
     	  (if (empty? l)
	      (reverse acc)
	      (let ([el (car l)])
	      	   (if (and (list? el)
		       	    (> depth 0))
		       (let ([acc2 (foldl (λ (a it) (cons it a))
		       	    	   	  acc
					  (flatten-n (- depth 1)
					   	     el))])
		       	    (helper (cdr l) acc2))
		       (helper (cdr l) (cons el acc))))))
    (helper lst '()))

(def (flatten lst)
     (def (helper l acc)
     	  (if (empty? l)
	      (reverse acc)
	      (let ([el (car l)])
	      	   (if (list? el)
		       (let ([acc2 (foldl (λ (a it) (cons it a))
		       	    	   	  acc
					  (flatten el))])
		       	    (helper (cdr l) acc2))
		       (helper (cdr l) (cons el acc))))))
    (helper lst '()))

(def (for-each items fn)
	(if (empty? items)
		nil
		(block
			(fn (car items))
			(for-each (cdr items) fn))))