#|
Various list functions
|#

(def (reverse lst)
  (def (helper l acc)
    (if l
      (helper (cdr l) (cons (car l) acc))
      acc))
  (helper lst nil))

(def (enumerate lst)
  (def (helper i l acc)
    (if l
      (helper (+ i 1) (cdr l) (cons (i . (car l)) acc))
      (reverse acc)))
  (helper 0 lst nil))

(def (member val lst eq-fn)
     (if (empty? lst)
     	  #f
	      (let ([x (car lst)])
	         (if (eq-fn val x)
	        	  lst
		          (member val (cdr lst) eq-fn)))))

(def (member val lst)
     (member val lst =))

(def (foldl fn init-val lst)
     (if (empty? lst)
     	 init-val
	     (foldl 
	 	     fn
		     (fn init-val (car lst))
         (cdr lst))))

(def (foldr fn init-val lst)
     (foldl (λ (acc it) (fn it acc))
	          init-val
            (reverse lst)))

(def (reduce fn lst)
     (foldl fn (car lst) (cdr lst)))
