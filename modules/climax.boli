(require 'string
         'list)

(provide 'create-config
         'config-add-option!
	 'config-parse
	 'config-parse-args)

(def-struct option (name value-required?))

(def-struct options (short-opts long-opts))

(def (create-config)
     (create-options (create-hash-table)
     		     (create-hash-table)))

(def (config-add-option! conf short long value-required?)
     (if (not (nil? short))
     	 (let ([short-opts (options-short-opts conf)])
	      (hash-set! short-opts
	      		 short
			 (create-option short value-required?)))
	 nil)
     (if (not (nil? long))
     	 (let ([long-opts (options-long-opts conf)])
	      (hash-set! long-opts
	      		 long
			 (create-option long value-required?)))
	 nil))

(def (short-option? conf optname)
     (hash-contains? (options-short-opts conf)
     		     optname))

(def (long-option? conf optname)
     (hash-contains? (options-long-opts conf)
     		     optname))

(def (value-required? conf optname)
     (if (short-option? conf optname)
     	 (option-value-required? (hash-get (options-short-opts conf)
	 			 	   optname))
	 (if (long-option? conf optname)
	     (option-value-required? (hash-get (options-long-opts conf)
	     			     	       optname))
	     #false)))

(def-struct input (chars idx))

(def (string->input s)
     (create-input (list->vector (string->list s))
     		   0))

(def (done? in)
     (>= (input-idx in)
     	 (count (input-chars in))))

(def (peek in offset)
     (let ([chars (input-chars in)]
     	   [idx (+ (input-idx in) offset)])
     	  (if (< idx (count chars))
     	      (vector-ref chars idx)
	      nil)))

(def (peek in)
     (peek in 0))

(def (advance! in)
     (let ([curr-idx (input-idx in)]
     	   [ch (peek in)])
     	  (input-set-idx! in (+ curr-idx 1))
     	  ch))

(def (skip-whitespace! in)
     (let ([ch (peek in)])
	  (if (and (not (nil? ch))
	      	   (char-whitespace? ch))
	      (block (advance! in)
	      	     (skip-whitespace! in))
	      nil)))

(def (scan-until! in init-str pred include-stop?)
     (def (helper! in acc)
     	  (if (done? in)
	      acc
	      (let ([ch (peek in)])
	      	   (if (pred ch)
		       (if include-stop?
		       	   (block (advance! in)
		       	   	  (string-concat acc ch))
		       	   acc)
		       (block (advance! in)
		       	      (helper! in (string-concat acc ch)))))))
     (helper! in init-str))
     
(def (scan-arg! in)
     (scan-until! in
     		  ""
		  char-whitespace?
		  #false))

(def (scan-string! in)
	(let ([s (scan-until! in "" (λ (ch) (equal? ch "\"")) #false)])
		(if (not (done? in))
			(advance! in)
			nil)
		s))

(def (scan-opt-value! in)
     (skip-whitespace! in)
     (let ([ch (peek in)])
     	  (if (equal? ch "\"")
	      (block (advance! in)
	      	     (scan-string! in))
	      (scan-arg! in))))

(def (scan-short-opt! conf in)
  (def (helper acc)
	  (let ([ch (peek in)])
			(cond [(or (nil? ch) 
			       (char-whitespace? ch)) (reverse acc)]
				    [(short-option? conf ch)
						 (block
						 	 (advance! in)
						   (if (value-required? conf ch)
						       (reverse (cons (ch . (scan-opt-value! in)) acc))
						       (helper (cons (ch . "") acc))))]
						[#t 
						 (error (string-concat ch " is not an option"))])))
	(helper '()))

(def (scan-long-opt! conf in)
	(let ([opt (scan-until! in "" (λ (ch) (or (char-whitespace? ch) (equal? ch "="))) #f)])
		(if (long-option? conf opt)
			(if (value-required? conf opt)
				(block
					(skip-whitespace! in)
					(if (equal? (peek in) "=")
						(block 
							(advance! in)
							(opt . (scan-opt-value! in)))
						(error "expected '=' but got none")))
				(opt . ""))
			(error (string-concat opt " is not an option")))))

(def (scan! conf in)
     (skip-whitespace! in)
     (let ([ch (peek in)])
     	  (cond [(equal? ch "\"") (block (advance! in)
	  		    	  	                     (scan-string! in))]
		          [(equal? ch "-") (block (advance! in)
			    	 		                      (let ([ch (peek in)])
					                               (if (equal? ch "-")
					     	                           (block (advance! in)
							                                    (scan-long-opt! conf in))
						                               (scan-short-opt! conf in))))]
							[#t (scan-arg! in)])))

(def (config-parse conf s)
     (def (parse-args-opts in acc)
     	  (if (done? in)
	      	(flatten-n 1 (reverse acc))
	      	(parse-args-opts in (cons (scan! conf in) acc))))
		 (def (separate aos args opts)
		 	 (if (empty? aos)
			 	 (args . opts)
				 (let ([ao (car aos)])
				 	(block
						(if (pair? ao)
							(hash-set! opts (car ao) (cdr ao))
							(vector-append! args ao))
						(separate (cdr aos) args opts)))))
     (separate
		 	 (parse-args-opts (string->input s) '())
			 (vector)
			 (create-hash-table)))

(def (config-parse-args conf args)
     (config-parse conf (foldl (λ (acc arg) (string-concat acc " " arg)) "" args)))