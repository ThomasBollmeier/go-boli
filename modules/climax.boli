(require 'string
	 'list)

(def-struct input (chars idx))

(def (string->input s)
     (create-input (list->vector (string->list s))
     		   0))

(def (done? in)
     (>= (input-idx in)
     	 (count (input-chars in))))

(def (peek in)
     (vector-ref (input-chars in)
     		 (input-idx in)))

(def (advance! in)
     (let ([curr-idx (input-idx in)]
     	   [ch (peek in)])
     	  (input-set-idx! in (+ curr-idx 1))
     	  ch))

(def (skip-whitespace! in)
     (if (not (done? in))
     	 (let ([ch (peek in)])
	      (if (char-whitespace? ch)
	      	  (block
			(advance! in)
			(skip-whitespace! in))
		  nil))
	 nil))

(def (scan-arg! in)
     (def (helper! in acc)
     	  (if (done? in)
	      acc
	      (let ([ch (peek in)])
	      	   (if (char-whitespace? ch)
		       acc
		       (block (advance! in)
		       	      (helper! in (string-concat acc ch)))))))
     (helper! in ""))