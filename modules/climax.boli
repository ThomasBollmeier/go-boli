(require 'string
	 'list)

(def-struct option (name value-required?))

(def-struct options (short-opts long-opts))

(def (create-config)
     (create-options (create-hash-table)
     		     (create-hash-table)))

(def (add-option! conf short long value-required?)
     (if (not (nil? short))
     	 (let ([short-opts (options-short-opts conf)])
	      (hash-set! short-opts
	      		 short
			 (create-option short value-required?)))
	 nil)
     (if (not (nil? long))
     	 (let ([long-opts (options-long-opts conf)])
	      (hash-set! long-opts
	      		 long
			 (create-option long value-required?)))
	 nil))

(def-struct input (chars idx))

(def (string->input s)
     (create-input (list->vector (string->list s))
     		   0))

(def (done? in)
     (>= (input-idx in)
     	 (count (input-chars in))))

(def (peek in offset)
     (let ([chars (input-chars in)]
     	   [idx (+ (input-idx in) offset)])
     	  (if (< idx (count chars))
     	      (vector-ref chars idx)
	      nil)))

(def (peek in)
     (peek in 0))

(def (advance! in)
     (let ([curr-idx (input-idx in)]
     	   [ch (peek in)])
     	  (input-set-idx! in (+ curr-idx 1))
     	  ch))

(def (skip-whitespace! in)
     (let ([ch (peek in)])
	  (if (and (not (nil? ch))
	      	   (char-whitespace? ch))
	      (block (advance! in)
	      	     (skip-whitespace! in))
	      nil)))

(def (scan-until! in init-str pred include-stop?)
     (def (helper! in acc)
     	  (if (done? in)
	      acc
	      (let ([ch (peek in)])
	      	   (if (pred ch)
		       (if include-stop?
		       	   (block (advance! in)
		       	   	  (string-concat acc ch))
		       	   acc)
		       (block (advance! in)
		       	      (helper! in (string-concat acc ch)))))))
     (helper! in init-str))
     
(def (scan-arg! in)
     (scan-until! in
     		  ""
		  char-whitespace?
		  #false))

(def (scan-string! in)
     (scan-until! in
     		  "\""
		  (λ (ch) (equal? ch "\""))
		  #true))

(def (scan! in)
     (skip-whitespace! in)
     (let ([ch (peek in)])
     	  (cond [(equal? ch "\"") (block (advance! in)
	  		    	  	 (scan-string! in))]
		[#t (scan-arg! in)])))
