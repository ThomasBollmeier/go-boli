(provide 
  'string-find
  'string-split
  'string-starts-with?
  'string->list
  'char-alpha?
  'char-numeric?
  'char-alpha-numeric?
  'char-whitespace?)

(require 'list)

(def (string-find s search)
  (def len-search (string-count search))
  (def (helper i n)
    (if (= i n)
      #f
      (let ([sub (string-sub s i len-search)])
        (if (string=? sub search)
          i
          (helper (+ i 1) n)))))
  (helper 0 (string-count s)))

(def (string-split s delim)
  (def len-delim (string-count delim))
  (def (helper s acc)
    (let ([idx (string-find s delim)])
      (if idx
        (block
          (if (> idx 0)
            (vector-append! acc (string-sub s 0 idx))
            nil)
          (helper (string-sub s (+ idx len-delim)) acc))
        (block
          (vector-append! acc s)
          acc))))
  (helper s (vector)))

(def (string-split s)
  (string-split s " "))

(def (string-starts-with? s prefix)
    (let ([n (count prefix)])
        (equal? prefix (take n s))))

(def (string->list s)
     (def (helper s acc)
     	  (if (empty? s)
	      (reverse acc)
	      (helper (cdr s)
	      	      (cons (car s)
		      	    acc))))
  (helper s (list)))

(def alpha-chars
     (create-set ...(list->vector (string->list "abcdefghijklmnopqrstuvxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"))))

(def number-chars
     (create-set ...(list->vector (string->list "0123456789"))))

(def whitespace-chars
     (create-set ...(list->vector (string->list " \t\n"))))

(def (char-alpha? ch)
     (set-contains? alpha-chars ch))

(def (char-numeric? ch)
     (set-contains? number-chars ch))

(def (char-alpha-numeric? ch)
     (or (char-alpha? ch)
     	 (char-numeric? ch)))

(def (char-whitespace? ch)
     (set-contains? whitespace-chars ch))

