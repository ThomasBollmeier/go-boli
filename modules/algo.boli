#|
Various algorithms
|#

(require 'vector)

(provide 
  'quicksort
  'mergesort)

;; quicksort of a vector
(def (quicksort v eq-fn compare-fn)
  (if (< (count v) 2)
    v
    (let ([i (random-int (count v))]
          [pivot (vector-ref v i)]
          [pivots (filter (lambda (x) (eq-fn pivot x)) v)]
          [left (filter (lambda (x) 
                          (and
                            (not (eq-fn pivot x))
                            (compare-fn x pivot))) 
                        v)]
          [right (filter (lambda (x) 
                            (and
                              (not (eq-fn pivot x))
                              (not (compare-fn x pivot)))) 
                          v)])
      (vector-concat 
        (quicksort left eq-fn compare-fn)
        pivots
        (quicksort right eq-fn compare-fn)))))

(def (quicksort v compare-fn)
  (quicksort v = compare-fn))

(def (quicksort v)
  (quicksort v <))

;; mergesort implementation for a vector:

(def (merge v1 v2 comp-fn)
     (def (helper i1 n1 i2 n2 acc)
     	  (cond
		    [(and (< i1 n1) (< i2 n2))
		      (let ([x1 (vector-ref v1 i1)]
		      	    [x2 (vector-ref v2 i2)])
			    (if (comp-fn x1 x2)
			    	(block
					    (vector-append! acc x1)
			    		(helper (+ i1 1) n1 i2 n2 acc))
				    (block
					    (vector-append! acc x2)
			    		(helper i1 n1 (+ i2 1)  n2 acc))))]   
		    [(>= i1 n1)
		     (if (< i2 n2)
		     	 (block
				    (vector-append! acc (vector-ref v2 i2))
				    (helper i1 n1 (+ i2 1) n2 acc))
			     acc)]
		    [(>= i2 n2)
		     (if (< i1 n1)
		     	 (block
				    (vector-append! acc (vector-ref v1 i1))
				    (helper (+ i1 1) n1 i2 n2 acc))
			     acc)]))
     (helper 0 (count v1) 0 (count v2) (vector)))

(def (mergesort v comp-fn)
     (let ([n (count v)])
     	  (if (< n 2)
     	      v
	          (let ([m (// n 2)]
	      	        [left (take m v)]
		            [right (drop m v)])
	      	    (merge (mergesort left comp-fn)
		   	           (mergesort right comp-fn)
			           comp-fn)))))

(def (mergesort v)
    (mergesort v <))